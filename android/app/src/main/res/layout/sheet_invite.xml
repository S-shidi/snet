<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/snet_content_padding">

    <View
        android:layout_width="@dimen/snet_sheet_drag_width"
        android:layout_height="@dimen/snet_sheet_drag_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_drag"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="邀请成员"
        android:textColor="@color/snet_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="邀请码"
        android:textColor="@color/snet_text_dim"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/inviteCodeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:textColor="@color/snet_text"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:gravity="center"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/snet_err"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeBtn"
            style="@style/SnetButtonGhost"
            android:layout_width="0dp"
            android:layout_height="@dimen/snet_button_height"
            android:layout_weight="1"
            android:text="关闭"
            android:layout_marginEnd="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyBtn"
            style="@style/SnetButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="@dimen/snet_button_height"
            android:layout_weight="1"
            android:text="复制"
            android:layout_marginStart="6dp"/>

    </LinearLayout>

</LinearLayout>
