<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/snet_content_padding">

    <View
        android:layout_width="@dimen/snet_sheet_drag_width"
        android:layout_height="@dimen/snet_sheet_drag_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_drag"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="加入网络"
        android:textColor="@color/snet_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/SnetInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="网络 ID">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/networkIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:fontFamily="monospace"
            android:textColor="@color/snet_text"
            android:textColorHint="@color/snet_text_faint"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/SnetInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="邀请码"
        android:layout_marginTop="@dimen/snet_form_gap">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:fontFamily="monospace"
            android:textColor="@color/snet_text"
            android:textColorHint="@color/snet_text_faint"/>

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/snet_err"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginTop="@dimen/snet_form_gap"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginTop="@dimen/snet_form_gap"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelBtn"
            style="@style/SnetButtonGhost"
            android:layout_width="0dp"
            android:layout_height="@dimen/snet_button_height"
            android:layout_weight="1"
            android:text="取消"
            android:layout_marginEnd="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/joinBtn"
            style="@style/SnetButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="@dimen/snet_button_height"
            android:layout_weight="1"
            android:text="加入"
            android:layout_marginStart="6dp"/>

    </LinearLayout>

</LinearLayout>
