<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/snet_card_padding">

        <!-- Row 1: name + toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/netName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/snet_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/netStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_ok"
                android:textColor="@color/snet_ok"
                android:textSize="11sp"
                android:text="已连接"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp"/>

            <!-- Toggle -->
            <FrameLayout
                android:id="@+id/netToggle"
                android:layout_width="44dp"
                android:layout_height="24dp">

                <View
                    android:id="@+id/netToggleTrack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_toggle_track"/>

                <View
                    android:id="@+id/netToggleThumb"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_toggle_thumb"/>

            </FrameLayout>

        </LinearLayout>

        <!-- Row 2: subnet -->
        <TextView
            android:id="@+id/netSubnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/snet_text_faint"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <!-- Row 3: peers + servers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/netPeers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 节点"
                android:textColor="@color/snet_text_dim"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/netServers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中继 0"
                android:textColor="@color/snet_text_dim"
                android:textSize="12sp"/>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/netSettingsBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_manage"
                android:contentDescription="网络设置"
                android:scaleType="centerInside"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
