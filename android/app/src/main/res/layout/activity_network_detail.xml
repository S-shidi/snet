<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snet_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/detailNetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/snet_text"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/detailNetIP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/snet_text_dim"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/detailNetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/snet_ok"
            android:layout_marginBottom="16dp"/>

        <!-- Action buttons: members, pending, invite -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/membersButton"
                style="@style/SnetButtonGhost"
                android:layout_width="0dp"
                android:layout_height="@dimen/snet_button_height_sm"
                android:layout_weight="1"
                android:text="成员"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pendingButton"
                style="@style/SnetButtonGhost"
                android:layout_width="0dp"
                android:layout_height="@dimen/snet_button_height_sm"
                android:layout_weight="1"
                android:text="待审批"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/inviteButton"
                style="@style/SnetButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="@dimen/snet_button_height_sm"
                android:layout_weight="1"
                android:text="邀请"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/SnetCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="子网路由"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/snet_text"/>

                    <Button
                        android:id="@+id/addSubnetButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+ 添加"
                        android:textSize="12sp"
                        android:visibility="gone"
                        style="@style/Widget.Material3.Button.TonalButton"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/subnetEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无子网"
                    android:textSize="13sp"
                    android:textColor="@color/snet_text_faint"
                    android:gravity="center"
                    android:padding="16dp"/>

                <LinearLayout
                    android:id="@+id/subnetList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/SnetCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="对等节点"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/snet_text"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/peerEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无对等节点"
                    android:textSize="13sp"
                    android:textColor="@color/snet_text_faint"
                    android:gravity="center"
                    android:padding="16dp"/>

                <LinearLayout
                    android:id="@+id/peerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rejoinButton"
                style="@style/SnetButtonGhost"
                android:layout_width="0dp"
                android:layout_height="@dimen/snet_button_height"
                android:layout_weight="1"
                android:text="重新连接"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/leaveButton"
                style="@style/SnetButtonDanger"
                android:layout_width="0dp"
                android:layout_height="@dimen/snet_button_height"
                android:layout_weight="1"
                android:text="离开网络"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
