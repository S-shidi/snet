{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snet",
  "version": "0.1.0",
  "identifier": "com.snet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Snet",
        "width": 840,
        "height": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/windows-amd64/snetd.exe": "snetd.exe",
      "../../build/windows-amd64/wintun.dll": "wintun.dll",
      "../../build/windows-amd64/LICENSE-wintun.txt": "LICENSE-wintun.txt"
    }
  }
}
